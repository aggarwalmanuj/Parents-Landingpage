# Copy to .env.local and fill in. Never commit a filled-in file: .gitignore
# excludes .env*, and this template is the only env file that belongs in git.
#
# Every value here is a PUBLIC, client-visible id (NEXT_PUBLIC_* is inlined
# into the browser bundle at build time) or a build flag. No secret belongs in
# this file or in any NEXT_PUBLIC_ variable.

# --- PostHog -----------------------------------------------------------------
# Project token from PostHog → Settings → Project. Analytics are consent-gated
# (lib/consent.ts): nothing initialises until the visitor presses Accept.
# Unset = PostHog never starts, and the page still works.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Dashboard host, used ONLY for toolbar / "Open in PostHog" links. Ingestion
# goes through the same-origin /ingest proxy (see rewrites in next.config.ts),
# never through this host. Defaults to https://us.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=

# "true" lets PostHog run in `next dev`. Leave EMPTY unless you are debugging
# analytics: dev clicks otherwise land in the production funnel.
NEXT_PUBLIC_POSTHOG_ENABLE_DEV=

# --- Meta Pixel --------------------------------------------------------------
# Numeric pixel id (6-20 digits; anything else is rejected before it reaches
# the inline script). Consent-gated like PostHog. Unset = no pixel.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Assessment handoff ------------------------------------------------------
# Where every CTA sends the visitor. Set this LOCALLY to a non-production URL:
# unset, the default in lib/scorecard.ts points at the live funnel, so each dev
# click creates a real lead row. Leave unset in production, where that default
# is the correct destination.
NEXT_PUBLIC_SCORECARD_BASE_URL=

# --- Security headers --------------------------------------------------------
# "true" emits the policy in next.config.ts as `Content-Security-Policy`
# instead of `Content-Security-Policy-Report-Only`.
#
# BUILD-TIME ONLY. `next build` serialises headers into the build output
# (.next/routes-manifest.json), so setting this in a runtime-only environment
# has no effect — it must be present for the build, and changing it requires a
# rebuild/redeploy, not a restart.
CSP_ENFORCE=
